LLM_API_KEY=your-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-reasoner
LLM_MOCK=false
LLM_TIMEOUT_SECONDS=60

STT_API_KEY=your-stt-api-key
STT_BACKEND=mock
